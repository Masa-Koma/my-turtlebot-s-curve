<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="mini4wd_single_track">

    <!-- ======================================================== -->
    <!--  ミニ四駆周回トラックコース（ベースライン走行用ワールド）    -->
    <!--  構成: 南北2本のロングストレート ＋ 東西2箇所の180度バンクコーナー -->
    <!--  識別: 外壁＝赤色（進行方向左/右）、内壁＝青色              -->
    <!-- ======================================================== -->

    <!-- 俯瞰モニタリング用カメラ（トラック全体を見下ろす視点） -->
    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose>0 0 13.0 0 1.57079 1.57079</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <include><uri>model://ground_plane</uri></include>
    <include><uri>model://sun</uri></include>

    <!-- ======================================================== -->
    <!-- 1. ストレートセクション（床面）                           -->
    <!-- ======================================================== -->
    <!-- 北側ストレート床面 -->
    <model name="floor_str_n"><static>true</static><pose>0 3.100 0.005 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>7.0 1.8 0.01</size></box></geometry></collision><visual name="v"><geometry><box><size>7.0 1.8 0.01</size></box></geometry><material><ambient>0.22 0.22 0.25 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material></visual></link></model>
    <!-- 南側ストレート床面 -->
    <model name="floor_str_s"><static>true</static><pose>0 -3.100 0.005 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>7.0 1.8 0.01</size></box></geometry></collision><visual name="v"><geometry><box><size>7.0 1.8 0.01</size></box></geometry><material><ambient>0.22 0.22 0.25 1</ambient><diffuse>0.22 0.22 0.25 1</diffuse></material></visual></link></model>

    <!-- ======================================================== -->
    <!-- 2. ストレートセクション（ガイド壁：外壁 赤 / 内壁 青）    -->
    <!-- ======================================================== -->
    <!-- 北側ストレート 外壁（赤） -->
    <model name="w_out_n"><static>true</static><pose>0 4.000 0.125 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>7.0 0.08 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>7.0 0.08 0.25</size></box></geometry><material><ambient>0.85 0.15 0.15 1</ambient><diffuse>0.85 0.15 0.15 1</diffuse></material></visual></link></model>
