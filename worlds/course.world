    <model name="w_in_n"><static>true</static><pose>0 2.200 0.125 0 0 0</pose><link name="l"><collision name="c"><geometry><box><size>7.0 0.08 0.25</size></box></geometry></collision><visual name="v"><geometry><box><size>7.0 0.08 0.25</size></box></geometry><material><ambient>0.15 0.25 0.85 1</ambient><diffuse>0.15 0.25 0.85 1</diffuse></material></visual></link></model>
